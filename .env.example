# ==============================================================================
# CloudOps Sentinel Backend Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME=cloudops-sentinel-api
APP_VERSION=0.1.0

# Server Binding
HOST=0.0.0.0
PORT=8000

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection (PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cloudops_user
POSTGRES_PASSWORD=cloudops_secure_password
POSTGRES_DB=cloudops_sentinel
DATABASE_URL=postgresql+psycopg://cloudops_user:cloudops_secure_password@localhost:5432/cloudops_sentinel

# Logging
LOG_LEVEL=INFO

# Monitoring & Recovery Engine Flags
ENABLE_METRIC_SIMULATOR=false
RECOVERY_DRY_RUN_MODE=true

