# CloudOps Sentinel Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Server Config
HOST=127.0.0.1
PORT=8000

# Security & JWT
JWT_SECRET=cloudops_super_secret_jwt_key_2026_sentinel
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL default in docker, SQLite fallback for local test)
DATABASE_URL=sqlite:///./cloudops_sentinel.db
# DATABASE_URL=postgresql+psycopg://cloudops_user:cloudops_secure_password@localhost:5432/cloudops_sentinel

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Next.js Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
