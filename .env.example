# ==============================================================================
# CloudOps Sentinel Platform Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
APP_NAME=cloudops-sentinel-api
APP_VERSION=0.1.0

# Backend Server Binding
HOST=0.0.0.0
PORT=8000

# Security & CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=cloudops_user
POSTGRES_PASSWORD=cloudops_secure_password
POSTGRES_DB=cloudops_sentinel
DATABASE_URL=postgresql+psycopg://cloudops_user:cloudops_secure_password@postgres:5432/cloudops_sentinel

# Logging
LOG_LEVEL=INFO

# Operational Safety Guardrails
RECOVERY_DRY_RUN_MODE=true
ENABLE_METRIC_SIMULATOR=false

# Frontend Dashboard Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000
